# 应用环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# 应用配置
APP_NAME=资产管理系统
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置（SQLite）
DATABASE_URL=sqlite:///./asset_management.db

# JWT密钥配置（生产环境请修改为强随机字符串）
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 跨域配置（多个来源用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 文件配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
BACKUP_DIR=backups
